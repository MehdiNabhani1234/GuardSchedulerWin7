                                                                    </ControlTemplate>
                                                                </Button.Template>

                                                            </Button>

                                                        </Grid>

                                                    </Border>

                                                    <TextBlock Text="لیست نیروهای جانشین"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#334155"
                                   Margin="0,0,0,10"/>

                                                    <StackPanel x:Name="ReserveOfficerContainer"/>

                                                </StackPanel>

                                            </Border>

                                        </StackPanel>

                                    </Border>


                                    <!-- =====================================================
             آکاردئون افسر سر
        ====================================================== -->

                                    <Border x:Name="ChiefAccordion"
                Background="#FFFDF7"
                BorderBrush="#FDE68A"
                BorderThickness="1"
                CornerRadius="18"
                Margin="0,0,0,14"
                FlowDirection="RightToLeft">

                                        <StackPanel>

                                            <Button x:Name="ChiefAccordionHeader"
                        Tag="chief"
                        Click="OfficerAccordionHeader_Click"
                        Background="#FFF7E6"
                        BorderBrush="#FCD34D"
                        BorderThickness="1"
                        Padding="18"
                        HorizontalContentAlignment="Stretch">

                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">

                                                        <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="16"
                                    Padding="{TemplateBinding Padding}">

                                                            <ContentPresenter
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center"/>

                                                        </Border>

                                                    </ControlTemplate>
                                                </Button.Template>

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="42"
                                Height="42"
                                CornerRadius="12"
                                Background="#D97706">

                                                        <TextBlock Text="⭐"
                                       FontSize="21"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                    Margin="14,0,0,0"
                                    VerticalAlignment="Center">

                                                        <TextBlock Text="افسران سر"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="#92400E"/>

                                                        <TextBlock Text="برای نمایش لیست اسامی کلیک کنید"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>

                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2"
                                   x:Name="ChiefAccordionArrow"
                                   Text="▶"
                                   FontSize="18"
                                   Foreground="#D97706"
                                   VerticalAlignment="Center"
                                   Margin="12,0,4,0"/>

                                                </Grid>

                                            </Button>


                                            <Border x:Name="ChiefAccordionContent"
                        Visibility="Collapsed"
                        Padding="18"
                        Background="#FFFFFF">

                                                <StackPanel>

                                                    <Border Background="#FFFFFF"
                                BorderBrush="#FFFFFF"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16"
                                Margin="0,0,0,14">

                                                        <Grid>

                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="150"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBox x:Name="ChiefOfficerEntry"
                                         Grid.Column="0"
                                         Height="44"
                                         Margin="0,0,10,0"
                                         Padding="12,0"
                                         VerticalContentAlignment="Center"
                                         FontSize="14"
                                         BorderBrush="#CBD5E1"
                                         BorderThickness="1"/>
                                                            <ComboBox x:Name="ChiefOfficerScorePicker"
          Grid.Column="1"
          Height="44"
          FontSize="14"
          Foreground="#334155"
          Background="#FFFFFF"
          BorderBrush="#D6DCE5"
          BorderThickness="1"
          Padding="0"
          Cursor="Hand">

                                                                <ComboBox.Template>

                                                                    <ControlTemplate TargetType="{x:Type ComboBox}">

                                                                        <Grid>

                                                                            <!-- بدنه اصلی -->
                                                                            <Border x:Name="MainBorder"
                        Background="#FFFFFF"
                        BorderBrush="#D6DCE5"
                        BorderThickness="1"
                        CornerRadius="10">

                                                                                <ToggleButton
                        Focusable="False"
                        ClickMode="Press"
                        Background="Transparent"
                        BorderThickness="0"
                        IsChecked="{Binding IsDropDownOpen,
                                  RelativeSource={RelativeSource TemplatedParent},
                                  Mode=TwoWay}">

                                                                                    <ToggleButton.Template>

                                                                                        <ControlTemplate TargetType="{x:Type ToggleButton}">

                                                                                            <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">

                                                                                                <Grid>

                                                                                                    <Grid.ColumnDefinitions>
                                                                                                        <ColumnDefinition Width="*"/>
                                                                                                        <ColumnDefinition Width="42"/>
                                                                                                    </Grid.ColumnDefinitions>

                                                                                                    <!-- مقدار انتخاب شده -->
                                                                                                    <ContentPresenter
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{Binding SelectionBoxItem,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                            ContentTemplate="{Binding SelectionBoxItemTemplate,
                                                      RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>

                                                                                                    <!-- ناحیه فلش -->
                                                                                                    <Border Grid.Column="1"
                                                Width="29"
                                                Height="29"
                                                CornerRadius="8"
                                                Background="#F1F5F9"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                                                                                        <TextBlock Text="⌄"
                                                       FontFamily="Segoe UI Symbol"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="#64748B"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="0,-2,0,0"/>

                                                                                                    </Border>

                                                                                                </Grid>

                                                                                            </Border>

                                                                                        </ControlTemplate>

                                                                                    </ToggleButton.Template>

                                                                                </ToggleButton>

                                                                            </Border>

                                                                            <!-- منوی بازشونده -->
                                                                            <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       StaysOpen="False">

                                                                                <Border Background="#FFFFFF"
                            BorderBrush="#D6DCE5"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="5"
                            Margin="0,6,0,0">

                                                                                    <ScrollViewer MaxHeight="180">

                                                                                        <ItemsPresenter/>

                                                                                    </ScrollViewer>

                                                                                </Border>

                                                                            </Popup>

                                                                        </Grid>

                                                                        <!-- حالت‌های ظاهری -->
                                                                        <ControlTemplate.Triggers>

                                                                            <!-- وقتی موس روی ComboBox است -->
                                                                            <Trigger Property="IsMouseOver"
                         Value="True">

                                                                                <Setter TargetName="MainBorder"
                            Property="BorderBrush"
                            Value="#B8C2D1"/>

                                                                            </Trigger>

                                                                            <!-- وقتی ComboBox باز یا Focus شده -->
                                                                            <Trigger Property="IsDropDownOpen"
                         Value="True">

                                                                                <Setter TargetName="MainBorder"
                            Property="BorderBrush"
                            Value="#94A3B8"/>

                                                                            </Trigger>

                                                                            <!-- غیرفعال -->
                                                                            <Trigger Property="IsEnabled"
                         Value="False">

                                                                                <Setter TargetName="MainBorder"
                            Property="Background"
                            Value="#F8FAFC"/>

                                                                                <Setter TargetName="MainBorder"
                            Property="BorderBrush"
                            Value="#E2E8F0"/>

                                                                            </Trigger>

                                                                        </ControlTemplate.Triggers>

                                                                    </ControlTemplate>

                                                                </ComboBox.Template>

                                                                <!-- آیتم‌های ComboBox -->
                                                                <ComboBox.ItemContainerStyle>

                                                                    <Style TargetType="{x:Type ComboBoxItem}">

                                                                        <Setter Property="Height"
                    Value="38"/>

                                                                        <Setter Property="FontSize"
                    Value="13"/>

                                                                        <Setter Property="Foreground"
                    Value="#334155"/>

                                                                        <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

                                                                        <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

                                                                        <Setter Property="Template">

                                                                            <Setter.Value>

                                                                                <ControlTemplate TargetType="{x:Type ComboBoxItem}">

                                                                                    <Border x:Name="ItemBorder"
                                Background="#FFFFFF"
                                CornerRadius="7"
                                Margin="2"
                                Padding="8,0">

                                                                                        <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                                                                                    </Border>

                                                                                    <ControlTemplate.Triggers>

                                                                                        <!-- Hover روی گزینه -->
                                                                                        <Trigger Property="IsMouseOver"
                                     Value="True">

                                                                                            <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#F1F5F9"/>

                                                                                        </Trigger>

                                                                                        <!-- گزینه انتخاب شده -->
                                                                                        <Trigger Property="IsSelected"
                                     Value="True">

                                                                                            <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#E8EEF7"/>

                                                                                            <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                                                                                        </Trigger>

                                                                                    </ControlTemplate.Triggers>

                                                                                </ControlTemplate>

                                                                            </Setter.Value>

                                                                        </Setter>

                                                                    </Style>

                                                                </ComboBox.ItemContainerStyle>

                                                                <ComboBoxItem Content="0.5"/>
                                                                <ComboBoxItem Content="1"/>
                                                                <ComboBoxItem Content="2"/>

                                                            </ComboBox>

                                                            <Button x:Name="ChiefAddButton"
                                        Grid.Column="2"
                                        Width="150"
                                        Height="44"
                                        Content="➕ افزودن نیرو"
                                        Click="AddChiefOfficer_Click"
                                        Background="#D97706"
                                        Foreground="White"
                                        BorderBrush="#D97706"
                                        BorderThickness="0"
                                        FontSize="13"
                                        FontWeight="Bold"
                                        Padding="15,0">

                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">

                                                                        <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="11">

                                                                            <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                                                        </Border>

                                                                    </ControlTemplate>
                                                                </Button.Template>

                                                            </Button>

                                                        </Grid>

                                                    </Border>

                                                    <TextBlock Text="لیست نیروهای افسر سر"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#334155"
                                   Margin="0,0,0,10"/>

                                                    <StackPanel x:Name="ChiefOfficerContainer"/>

                                                </StackPanel>

                                            </Border>

                                        </StackPanel>

                                    </Border>

                                </StackPanel>

                            </Grid>

                        </ScrollViewer>

                        <!-- =====================================================
     PRELOADER گزارشات
===================================================== -->

                        <Grid x:Name="ReportsLoadingOverlay"
                      Grid.Row="1"
                      Visibility="Collapsed"
                      Background="#F8FAFC"
                      Panel.ZIndex="9999">

                            <Border Width="560"
            Height="360"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="35">

                                <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                                    <!-- آیکون -->

                                    <Border Width="76"
                    Height="76"
                    CornerRadius="22"
                    Background="#E8F1FF"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,18">

                                        <TextBlock Text="📊"
                           FontSize="39"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                                    </Border>


                                    <!-- عنوان -->

                                    <TextBlock Text="در حال آماده‌سازی گزارشات"
                       FontSize="23"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       HorizontalAlignment="Center"/>


                                    <!-- متن مرحله -->

                                    <TextBlock x:Name="ReportsLoadingText"
                       Text="در حال شروع..."
                       FontSize="13"
                       Foreground="#64748B"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,24"/>


                                    <!-- نوار پیشرفت -->

                                    <Border Width="420"
                                                Height="16"
                                                Background="#E2E8F0"
                                                CornerRadius="8"
                                                HorizontalAlignment="Center">

                                        <ProgressBar x:Name="ReportsLoadingProgress"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="0"
                                                         Height="16"
                                                         Background="#E2E8F0"
                                                         Foreground="#2563EB"
                                                         BorderThickness="0"/>

                                    </Border>


                                    <!-- درصد -->

                                    <TextBlock x:Name="ReportsLoadingPercent"
                       Text="0%"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="#2563EB"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"/>


                                    <!-- وضعیت -->

                                    <TextBlock x:Name="ReportsLoadingStatus"
                       Text="لطفاً صبر کنید..."
                       FontSize="11"
                       Foreground="#94A3B8"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

                                </StackPanel>

                            </Border>
                        </Grid>

                    </Grid>

                </ScrollViewer>

            </Grid>

        </Grid>

    </Grid>

</Window>