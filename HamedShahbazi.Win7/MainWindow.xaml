<Window x:Class="HamedShahbazi.Win7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="سامانه مدیریت برنامه نگهبانی"
        Width="1400"
        Height="850"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FlowDirection="LeftToRight"
        Background="#EEF2F7"
        Closing="MainWindow_Closing"
        Loaded="MainWindow_Loaded">


    <Grid>

        <!-- =====================================================
             صفحه شروع
             ===================================================== -->

        <Grid x:Name="StartupView"
      Visibility="Visible"
      Background="#EEF2F7">

            <Grid>

                <!-- پس‌زمینه تزئینی -->

                <Ellipse Width="520"
                 Height="520"
                 Fill="#DBEAFE"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-220,-210,0,0"
                 Opacity="0.55"/>

                <Ellipse Width="430"
                 Height="430"
                 Fill="#EDE9FE"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-180,-170"
                 Opacity="0.55"/>


                <!-- کارت اصلی -->

                <Border Width="500"
                Padding="42"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                    <StackPanel>

                        <!-- لوگو -->

                        <Border Width="88"
                        Height="88"
                        Background="#0F172A"
                        CornerRadius="24"
                        HorizontalAlignment="Center">

                            <TextBlock Text="🛡️"
                               FontSize="42"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        </Border>

                        <TextBlock Text="سامانه هوشمند"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#0F172A"
                           HorizontalAlignment="Center"
                           Margin="0,26,0,0"/>

                        <TextBlock Text="مدیریت برنامه نگهبانی"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           HorizontalAlignment="Center"
                           Margin="0,2,0,0"/>

                        <TextBlock Text="تولید، مدیریت و بررسی هوشمند لوحه نگهبانی"
                           FontSize="14"
                           Foreground="#64748B"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,30"/>


                        <!-- دکمه تنظیمات -->

                        <Button Content="⚙️   تنظیمات برنامه"
                        Click="OpenSettings_Click"
                        Height="54"
                        Background="#0F172A"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="20,0"
                        Margin="0,0,0,12"/>


                        <!-- دکمه شروع -->

                        <Button Content="▶   شروع برنامه"
                        Click="StartProgram_Click"
                        Height="54"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="20,0"/>


                        <Border Height="1"
                        Background="#E2E8F0"
                        Margin="0,28,0,18"/>

                        <TextBlock Text="سامانه مدیریت لوحه نگهبانی"
                           FontSize="12"
                           Foreground="#94A3B8"
                           HorizontalAlignment="Center"/>

                        <TextBlock Text="نسخه Windows"
                           FontSize="11"
                           Foreground="#CBD5E1"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>


        <!-- =====================================================
             برنامه اصلی
             ===================================================== -->

        <Grid x:Name="MainApplicationView"
              Visibility="Collapsed">

            <Grid.ColumnDefinitions>

                <!-- محتوا -->
                <ColumnDefinition Width="*"/>

                <!-- سایدبار -->
                <ColumnDefinition Width="280"/>

            </Grid.ColumnDefinitions>


            <!-- =================================================
                 SIDEBAR
                 ================================================= -->

            <Border Grid.Column="1"
                    Background="#0B1220">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="110"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="92"/>
                    </Grid.RowDefinitions>


                    <!-- =========================================
             HEADER SIDEBAR
             ========================================= -->

                    <Border Grid.Row="0"
                Background="#101B30"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1">

                        <StackPanel VerticalAlignment="Center">

                            <Border Width="44"
                        Height="44"
                        Background="#2563EB"
                        CornerRadius="13"
                        HorizontalAlignment="Center">

                                <TextBlock Text="🛡️"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                            </Border>

                            <TextBlock Text="سامانه نگهبانی"
                           Foreground="White"
                           FontSize="17"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- =========================================
             MENU
             ========================================= -->

                    <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="14,24,14,20">

                            <TextBlock Text="منوی اصلی"
                           Foreground="#64748B"
                           FontSize="11"
                           FontWeight="Bold"
                           Margin="12,0,0,10"
                           HorizontalAlignment="Right"/>


                            <!-- =================================================
     DASHBOARD
================================================== -->

                            <Button Height="50"
        Margin="0,4"
        Padding="18,0"
        HorizontalContentAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Background="#172554"
        Foreground="White"
        BorderThickness="0"
        FontSize="14"
        FontWeight="SemiBold"
        Cursor="Hand"
        Click="DashboardMenu_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">

                                            <ContentPresenter
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>


                                <StackPanel Orientation="Horizontal"
                FlowDirection="RightToLeft"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">

                                    <!-- آیکون داشبورد -->
                                    <TextBlock Text="▦"
                   FontFamily="Segoe UI Symbol"
                   FontSize="21"
                   FontWeight="Bold"
                   Foreground="#60A5FA"
                   VerticalAlignment="Center"
                   Width="34"
                   TextAlignment="Center"/>

                                    <!-- متن -->
                                    <TextBlock Text="داشبورد"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="White"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>

                                </StackPanel>

                            </Button>


                            <!-- =================================================
     SETTINGS
================================================== -->

                            <Button Height="50"
        Margin="0,4"
        Padding="18,0"
        HorizontalContentAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        Foreground="#CBD5E1"
        BorderThickness="0"
        FontSize="14"
        FontWeight="SemiBold"
        Cursor="Hand"
        Click="SettingsMenu_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">

                                            <ContentPresenter
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>


                                <StackPanel Orientation="Horizontal"
                FlowDirection="RightToLeft"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">

                                    <!-- آیکون -->
                                    <TextBlock Text="⚙"
                   FontFamily="Segoe UI Symbol"
                   FontSize="21"
                   FontWeight="Bold"
                   Foreground="#A78BFA"
                   VerticalAlignment="Center"
                   Width="34"
                   TextAlignment="Center"/>

                                    <!-- متن -->
                                    <TextBlock Text="تنظیمات"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#CBD5E1"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>

                                </StackPanel>

                            </Button>


                            <!-- =================================================
     OFFICER MANAGEMENT
================================================== -->

                            <Button Height="50"
        Margin="0,4"
        Padding="18,0"
        HorizontalContentAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        Foreground="#CBD5E1"
        BorderThickness="0"
        FontSize="14"
        FontWeight="SemiBold"
        Cursor="Hand"
        Click="OfficerManagementMenu_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">

                                            <ContentPresenter
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>


                                <StackPanel Orientation="Horizontal"
                FlowDirection="RightToLeft"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">

                                    <!-- آیکون -->
                                    <TextBlock Text="♟"
                   FontFamily="Segoe UI Symbol"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#34D399"
                   VerticalAlignment="Center"
                   Width="34"
                   TextAlignment="Center"/>

                                    <!-- متن -->
                                    <TextBlock Text="مدیریت افسرها"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#CBD5E1"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>

                                </StackPanel>

                            </Button>


                            <!-- =================================================
     CREATE PROGRAM
================================================== -->

                            <Button Height="50"
        Margin="0,4"
        Padding="18,0"
        HorizontalContentAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        Foreground="#CBD5E1"
        BorderThickness="0"
        FontSize="14"
        FontWeight="SemiBold"
        Cursor="Hand"
        Click="CreateProgramMenu_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">

                                            <ContentPresenter
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>


                                <StackPanel Orientation="Horizontal"
                FlowDirection="RightToLeft"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">

                                    <!-- آیکون -->
                                    <TextBlock Text="✦"
                   FontFamily="Segoe UI Symbol"
                   FontSize="23"
                   FontWeight="Bold"
                   Foreground="#60A5FA"
                   VerticalAlignment="Center"
                   Width="34"
                   TextAlignment="Center"/>

                                    <!-- متن -->
                                    <TextBlock Text="ایجاد برنامه"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#CBD5E1"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>

                                </StackPanel>

                            </Button>


                            <!-- =================================================
     GUARD SCHEDULE
================================================== -->

                            <Button Height="50"
        Margin="0,4"
        Padding="18,0"
        HorizontalContentAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        Foreground="#CBD5E1"
        BorderThickness="0"
        FontSize="14"
        FontWeight="SemiBold"
        Cursor="Hand"
        Click="ScheduleMenu_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">

                                            <ContentPresenter
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>


                                <StackPanel Orientation="Horizontal"
                FlowDirection="RightToLeft"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">

                                    <!-- آیکون -->
                                    <TextBlock Text="▣"
                   FontFamily="Segoe UI Symbol"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#FBBF24"
                   VerticalAlignment="Center"
                   Width="34"
                   TextAlignment="Center"/>

                                    <!-- متن -->
                                    <TextBlock Text="برنامه نگهبانی"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#CBD5E1"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>

                                </StackPanel>

                            </Button>

                            <!-- =================================================
     راهنما
================================================== -->

                            <Button Height="50"
                                    Margin="0,4"
                                    Padding="18,0"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    Foreground="#CBD5E1"
                                    BorderThickness="0"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    Click="GuideMenu_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">

                                            <ContentPresenter
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>

                                <Grid     FlowDirection="RightToLeft">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <!-- آیکون رنگی -->

                                    <TextBlock Grid.Column="0"
                                               Text="📖"
                                               FontSize="21"
                                               Foreground="#A78BFA"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>


                                    <!-- متن -->

                                    <TextBlock Grid.Column="1"
                                               Text="راهنما"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#CBD5E1"
                                               VerticalAlignment="Center"
                                               Margin="5,0,0,0"/>

                                </Grid>

                            </Button>
                            <!-- =================================================
     REPORTS
================================================== -->

                            <Button Height="50"
        Margin="0,4"
        Padding="18,0"
        HorizontalContentAlignment="Stretch"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        Foreground="#CBD5E1"
        BorderThickness="0"
        FontSize="14"
        FontWeight="SemiBold"
        Cursor="Hand"
        Click="ReportsMenu_Click">

                                <Button.Template>
                                    <ControlTemplate TargetType="Button">

                                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">

                                            <ContentPresenter
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"/>

                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>


                                <StackPanel Orientation="Horizontal"
                FlowDirection="RightToLeft"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">

                                    <!-- آیکون -->
                                    <TextBlock Text="▥"
                   FontFamily="Segoe UI Symbol"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#FB7185"
                   VerticalAlignment="Center"
                   Width="34"
                   TextAlignment="Center"/>

                                    <!-- متن -->
                                    <TextBlock Text="گزارش‌ها"
                   FontSize="14"
                   FontWeight="SemiBold"
                   Foreground="#CBD5E1"
                   VerticalAlignment="Center"
                   Margin="8,0,0,0"/>

                                </StackPanel>

                            </Button>
                        </StackPanel>

                    </ScrollViewer>


                    <!-- =========================================
             SYSTEM STATUS
             ========================================= -->

                    <Border Grid.Row="2"
                Background="#101B30"
                Padding="14">

                        <Border Background="#0F172A"
                    BorderBrush="#1E293B"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="12">

                            <StackPanel>

                                <TextBlock Text="وضعیت سیستم"
                               Foreground="#64748B"
                               FontSize="10"
                               HorizontalAlignment="Right"/>

                                <StackPanel Orientation="Horizontal"
                                Margin="0,6,0,0">

                                    <Ellipse Width="8"
                                 Height="8"
                                 Fill="#22C55E"
                                 HorizontalAlignment="Right"/>

                                    <TextBlock Text="  سیستم آماده است"
                                   Foreground="#86EFAC"
                                   FontSize="12"
                                   HorizontalAlignment="Right"
                                   FontWeight="Bold"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                    </Border>

                </Grid>

            </Border>


            <!-- =================================================
                 RIGHT SIDE
                 ================================================= -->

            <Grid Grid.Column="0"
                  Background="#F1F5F9">

                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- =================================================
                     HEADER
                     ================================================= -->
                <Border Grid.Row="0"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="0,0,0,1"
                        Padding="28,12">

                    <Grid    FlowDirection="RightToLeft">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <!-- عنوان -->

                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                 
                                    >

                            <TextBlock Text="سامانه مدیریت برنامه نگهبانی"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"/>

                            <TextBlock Text="مدیریت هوشمند لوحه و نیروها"
                                       FontSize="12"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>

                        </StackPanel>


                        <!-- وضعیت -->

                        <Border Grid.Column="1"
                                Background="#ECFDF5"
                                BorderBrush="#BBF7D0"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,9"
                                VerticalAlignment="Center">

                            <StackPanel Orientation="Horizontal">

                                <Ellipse Width="9"
                                         Height="9"
                                         Fill="#22C55E"
                                         VerticalAlignment="Center"/>

                                <TextBlock Text="  سیستم آماده است"
                                           Foreground="#047857"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>


                <!-- =================================================
                     CONTENT
                     ================================================= -->

                <ScrollViewer x:Name="MainContentScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <Grid Margin="28">

                        <!-- DASHBOARD -->

                        <Grid x:Name="DashboardView"
                              Visibility="Visible">

                            <StackPanel>


                                <!-- ==================================
                                     DASHBOARD HEADER
                                     ================================== -->

                                <Border Background="#111827"
                                        CornerRadius="24"
                                        Padding="28"
                                        Margin="0,0,0,22"
                                        BorderBrush="#1E293B"
                                        BorderThickness="1">

                                    <Grid  FlowDirection="RightToLeft">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">

                                            <TextBlock Text="سلام، خوش آمدید 👋"
                                                       FontSize="14"
                                                       Foreground="#94A3B8"/>

                                            <TextBlock Text="مدیریت لوحه نگهبانی"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       Margin="0,6,0,0"/>

                                            <TextBlock Text="تمام بخش‌های سامانه را از منوی سمت راست مدیریت کنید."
                                                       FontSize="13"
                                                       Foreground="#CBD5E1"
                                                       Margin="0,5,0,0"/>

                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Background="#1E293B"
                                                BorderBrush="#334155"
                                                BorderThickness="1"
                                                CornerRadius="16"
                                                Padding="18,12">

                                            <StackPanel>

                                                <TextBlock Text="امروز"
                                                           FontSize="12"
                                                           Foreground="#94A3B8"
                                                           HorizontalAlignment="Center"/>

                                                <TextBlock x:Name="TodayDateLabel"
                                                           Text="---/--/--"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,3,0,0"/>

                                                <TextBlock x:Name="TodayDayLabel"
                                                           Text="---"
                                                           FontSize="12"
                                                           Foreground="#60A5FA"
                                                           HorizontalAlignment="Center"/>

                                            </StackPanel>

                                        </Border>

                                    </Grid>

                                </Border>


                                <!-- ==================================
                                     MAIN DASHBOARD CARD
                                     ================================== -->

                                <Border Background="#F8FAFC"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        CornerRadius="20"
                                        Padding="22">

                                    <StackPanel>


                                        <Grid  FlowDirection="RightToLeft">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>


                                            <StackPanel>

                                                <TextBlock Text="داشبورد مدیریت نگهبانی"
                                                           FontSize="25"
                                                           FontWeight="Bold"
                                                           Foreground="#0F172A"/>

                                                <TextBlock Text="نمای کلی وضعیت برنامه، نیروها و عملکرد نگهبانی"
                                                           FontSize="13"
                                                           Foreground="#64748B"
                                                           Margin="0,4,0,0"/>

                                            </StackPanel>


                                            <Border Grid.Column="1"
                                                    Background="#ECFDF5"
                                                    BorderBrush="#A7F3D0"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="16,10">

                                                <StackPanel Orientation="Horizontal">

                                                    <TextBlock Text="●"
                                                               Foreground="#10B981"
                                                               FontSize="13"/>

                                                    <TextBlock x:Name="DashboardStatusLabel"
                                                               Text="فعال"
                                                               Foreground="#047857"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Margin="7,0,0,0"/>

                                                </StackPanel>

                                            </Border>

                                        </Grid>


                                        <Border Height="1"
                                                Background="#E2E8F0"
                                                Margin="0,18"/>


                                        <!-- ==================================
                                             STAT ROW 1
                                             ================================== -->

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>


                                            <!-- =====================================================
         1 - روزهای برنامه
         ===================================================== -->

                                            <Border Grid.Column="0"
            Background="#EFF6FF"
            BorderBrush="#BFDBFE"
            BorderThickness="1"
            CornerRadius="20"
            Padding="22"
            Margin="0,0,8,0"
            FlowDirection="RightToLeft">

                                                <StackPanel>

                                                    <!-- آیکون بدون پس‌زمینه -->
                                                    <TextBlock Text="▣"
                       FontFamily="Segoe UI Symbol"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#2563EB"
                       HorizontalAlignment="Left"/>

                                                    <TextBlock Text="روزهای برنامه"
                       FontSize="12"
                       Foreground="#64748B"
                       Margin="0,10,0,0"/>

                                                    <TextBlock x:Name="DashboardDaysLabel"
                       Text="31"
                       FontSize="31"
                       FontWeight="Bold"
                       Foreground="#2563EB"/>

                                                    <TextBlock Text="روز"
                       FontSize="11"
                       Foreground="#64748B"/>

                                                </StackPanel>

                                            </Border>


                                            <!-- =====================================================
         2 - نیرو
         ===================================================== -->

                                            <Border Grid.Column="1"
            Background="#F5F3FF"
            BorderBrush="#DDD6FE"
            BorderThickness="1"
            CornerRadius="18"
            Padding="18"
            Margin="7,0"
            FlowDirection="RightToLeft">

                                                <StackPanel>

                                                    <!-- آیکون بدون پس‌زمینه -->
                                                    <TextBlock Text="♟"
                       FontFamily="Segoe UI Symbol"
                       FontSize="31"
                       FontWeight="Bold"
                       Foreground="#7C3AED"
                       HorizontalAlignment="Left"/>

                                                    <TextBlock Text="کل نیروها"
                       FontSize="12"
                       Foreground="#64748B"
                       Margin="0,10,0,0"/>

