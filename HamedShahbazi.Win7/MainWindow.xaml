                         Value="True">

                                                                        <Setter Property="Background"
                            Value="Transparent"/>

                                                                        <Setter Property="Foreground"
                            Value="#1F2937"/>

                                                                    </Trigger>

                                                                </Style.Triggers>

                                                            </Style>

